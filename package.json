{
  "name": "judge-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Async worker that runs LLM-as-a-judge grading over batches of already-ingested trace data, pulled off a Redis/BullMQ queue.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutations": "vitest run test/mutations.test.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "worker": "tsx src/cli/worker.ts",
    "calibrate": "tsx src/cli/calibrate.ts",
    "loadtest": "tsx src/cli/loadtest.ts",
    "dlq": "tsx src/cli/dlq.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
