# Copy to .env for local overrides. Every variable has a working default (see src/config/env.ts)
# -- the default demo (pnpm run ingest && pnpm run worker) needs none of these set.

REDIS_URL=redis://127.0.0.1:6379
JUDGE_QUEUE_NAME=judge-grading
WORKER_CONCURRENCY=5
QUEUE_DEPTH_LIMIT=2000
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=500

# Only read when a CLI is run with --live. Unset by default -- the mock judge provider is
# the default and needs no API key.
JUDGE_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_RETRIES=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=30000

# Optional per-run spend cap; unset means unlimited. Only ever trips against --live (the mock
# judge's costUsd is always null).
MAX_RUN_COST_USD=

LOG_LEVEL=info
